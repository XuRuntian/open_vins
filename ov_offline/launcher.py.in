#!/usr/bin/env python3
"""Compatibility CLI: output_dir is the final trajectory directory."""
import sys
from pathlib import Path

sys.path.insert(0, "@OPENVINS_SOURCE_ROOT@")
from ov_offline.run import parse_args, run

if __name__ == "__main__":
    binary = Path(__file__).resolve().with_name("openvins_offline_native")
    args = parse_args(["--binary", str(binary), *sys.argv[1:]])
    # The original orchestrator already appends /trajectory to output_dir.
    destination = args.output_dir if args.manifest is None else None
    raise SystemExit(run(args, output_dir=destination, legacy_report=True))
